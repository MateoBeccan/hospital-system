<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Empleado.
    -->
    <changeSet id="20260424181242-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="persona_id"
                                 baseTableName="empleado"
                                 constraintName="fk_empleado__persona_id"
                                 referencedColumnNames="id"
                                 referencedTableName="persona"
                                 />

        <addForeignKeyConstraint baseColumnNames="tipo_empleado_id"
                                 baseTableName="empleado"
                                 constraintName="fk_empleado__tipo_empleado_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tipo_empleado"
                                 />

        <addForeignKeyConstraint baseColumnNames="estado_laboral_id"
                                 baseTableName="empleado"
                                 constraintName="fk_empleado__estado_laboral_id"
                                 referencedColumnNames="id"
                                 referencedTableName="estado_laboral"
                                 />

        <addForeignKeyConstraint baseColumnNames="cargo_id"
                                 baseTableName="empleado"
                                 constraintName="fk_empleado__cargo_id"
                                 referencedColumnNames="id"
                                 referencedTableName="cargo"
                                 />
    </changeSet>
</databaseChangeLog>
